# Dry-run is the default. Setting this to 1 is standing authorization for
# the plugin to publish one matching quota-reset post per cooldown window.
WHAT_TIBO_SAID_LIVE=0

# Preferred: OAuth 2.0 credential JSON containing clientId, clientSecret,
# accessToken, and refreshToken. If omitted, the MCP checks
# ~/.config/what-tibo-said/x-oauth.json.
# WHAT_TIBO_SAID_X_CREDENTIALS_FILE=/absolute/path/to/x-oauth.json

# Compatibility fallback: a static OAuth 2.0 user access token. It cannot be
# refreshed automatically.
# X_USER_ACCESS_TOKEN=

# Optional settings.
TIBO_X_HANDLE=tibo
WHAT_TIBO_SAID_COOLDOWN_HOURS=24
# WHAT_TIBO_SAID_STATE_DIR=/absolute/path/to/private/state
